@model IEnumerable<NexusWork.Models.PayrollEntry>

@{
    ViewData["Title"] = "My Payroll";
    var employee = ViewBag.Employee as NexusWork.Models.Employee;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="bi bi-cash-stack"></i> My Payroll History
        </h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Pay Period</th>
                                <th>Basic Salary</th>
                                <th>Allowances</th>
                                <th>Deductions</th>
                                <th>Net Salary</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.PayPeriod</strong></td>
                                    <td> $ @item.BasicSalaryBDT.ToString("N2")</td>
                                    <td class="text-success">
                                        + $ @((item.HouseRentBDT + item.MedicalAllowanceBDT + item.TransportAllowanceBDT + item.BonusBDT).ToString("N2"))
                                    </td>
                                    <td class="text-danger">- $ @item.DeductionsBDT.ToString("N2")</td>
                                    <td class="fw-bold text-primary">$ @item.NetSalaryBDT.ToString("N2")</td>
                                    <td>
                                        @if (item.IsPaid)
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Pending</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-cash fs-1 text-muted"></i>
                <h4 class="mt-3">No Payroll Records</h4>
                <p class="text-muted">Your payroll history will appear here once processed.</p>
            </div>
        </div>
    }
</div>