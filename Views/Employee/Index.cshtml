@model IEnumerable<NexusWork.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="bi bi-people"></i> Employees
        </h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> Add New Employee
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Employee ID</th>
                                <th>Name</th>
                                <th>Email</th>
                                <th>Department</th>
                                <th>Designation</th>
                                <th>Basic Salary</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@item.EmployeeCode</strong></td>
                                    <td>@item.FullName</td>
                                    <td>@item.Email</td>
                                    <td>@item.Department</td>
                                    <td>@item.Designation</td>
                                    <td>৳ @item.BasicSalaryBDT.ToString("N2")</td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-people fs-1 text-muted"></i>
                <h4 class="mt-3">No Employees Found</h4>
                <p class="text-muted">Start by adding your first employee.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-person-plus"></i> Add First Employee
                </a>
            </div>
        </div>
    }
</div>
