@model NexusWork.Models.Employee

@{
    ViewData["Title"] = "Employee Details";
}

<div class="container">
    <h1 class="mb-4">
        <i class="bi bi-person-circle"></i> Employee Details
    </h1>

    <div class="row">
        <div class="col-md-8">
            <!-- Personal Information -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-person"></i> Personal Information
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Full Name</label>
                            <p class="form-control-plaintext fw-bold fs-5">@Model.FullName</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Employee ID</label>
                            <p class="form-control-plaintext fw-bold">@Model.EmployeeCode</p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Email</label>
                            <p class="form-control-plaintext">@Model.Email</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Phone</label>
                            <p class="form-control-plaintext">@Model.PhoneNumber</p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label text-muted">Gender</label>
                            <p class="form-control-plaintext">@Model.Gender</p>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted">Date of Birth</label>
                            <p class="form-control-plaintext">@Model.DateOfBirth.ToString("dd MMM yyyy")</p>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-muted">NID</label>
                            <p class="form-control-plaintext">@Model.NationalId</p>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted">Address</label>
                        <p class="form-control-plaintext">@(Model.Address ?? "Not provided")</p>
                    </div>
                </div>
            </div>

            <!-- Employment Information -->
            <div class="card mb-4">
                <div class="card-header bg-success text-white">
                    <i class="bi bi-briefcase"></i> Employment Information
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Department</label>
                            <p class="form-control-plaintext fw-bold">@Model.Department</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Designation</label>
                            <p class="form-control-plaintext fw-bold">@Model.Designation</p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Joining Date</label>
                            <p class="form-control-plaintext">@Model.JoiningDate.ToString("dd MMM yyyy")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Status</label>
                            <p class="form-control-plaintext">
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success fs-6">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger fs-6">Inactive</span>
                                }
                            </p>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Basic Salary</label>
                            <p class="form-control-plaintext fw-bold text-success fs-5">৳ @Model.BasicSalaryBDT.ToString("N2")</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bank Information -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <i class="bi bi-bank"></i> Bank Information
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Bank Name</label>
                            <p class="form-control-plaintext">@Model.BankName</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Account Number</label>
                            <p class="form-control-plaintext">@Model.BankAccountNumber</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="mt-4">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                    <i class="bi bi-pencil"></i> Edit
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                    <i class="bi bi-trash"></i> Delete
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Back to List
                </a>
            </div>
        </div>
    </div>
</div>