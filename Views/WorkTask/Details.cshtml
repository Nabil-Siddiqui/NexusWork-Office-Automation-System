@model NexusWork.Models.WorkTask

@{
    ViewData["Title"] = "Task Details";
}

<div class="container">
    <h1 class="mb-4">
        <i class="bi bi-eye"></i> Task Details
    </h1>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-list-task"></i> @Model.Title</span>
                    <span class="badge @Model.PriorityBadgeClass">@Model.Priority Priority</span>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Assigned To</label>
                            <p class="form-control-plaintext fw-bold">@(Model.Employee?.FullName ?? "N/A")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Status</label>
                            <p class="form-control-plaintext">
                                <span class="badge @Model.StatusBadgeClass fs-6">@Model.Status</span>
                                @if (Model.IsOverdue)
                                {
                                    <span class="badge bg-danger fs-6 ms-2">Overdue</span>
                                }
                            </p>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted">Description</label>
                        <div class="p-3 bg-light rounded">
                            @Model.Description
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted">Assigned Date</label>
                            <p class="form-control-plaintext">@Model.AssignedDate.ToString("dd MMMM yyyy")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted">Deadline</label>
                            <p class="form-control-plaintext @(Model.IsOverdue ? "text-danger fw-bold" : "")">
                                @Model.Deadline.ToString("dd MMMM yyyy")
                                @if (Model.IsOverdue)
                                {
                                    <span class="text-danger">(Overdue!)</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    }
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>