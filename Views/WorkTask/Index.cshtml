@model IEnumerable<NexusWork.Models.WorkTask>

@{
    ViewData["Title"] = User.IsInRole("Admin") ? "All Tasks" : "My Tasks";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="bi bi-list-task"></i> @ViewData["Title"]
        </h1>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Assign New Task
            </a>
        }
    </div>

    @if (Model.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Title</th>
                                @if (User.IsInRole("Admin"))
                                {
                                    <th>Assigned To</th>
                                }
                                <th>Assigned Date</th>
                                <th>Deadline</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr class="@(item.IsOverdue ? "table-danger" : "")">
                                    <td>
                                        <strong>@item.Title</strong>
                                        @if (item.IsOverdue)
                                        {
                                            <span class="badge bg-danger ms-2">Overdue</span>
                                        }
                                    </td>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <td>@(item.Employee?.FullName ?? "N/A")</td>
                                    }
                                    <td>@item.AssignedDate.ToString("dd MMM yyyy")</td>
                                    <td>@item.Deadline.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="badge @item.PriorityBadgeClass">@item.Priority</span>
                                    </td>
                                    <td>
                                        <span class="badge @item.StatusBadgeClass">@item.Status</span>
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Delete">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <h4 class="mt-3">No Tasks Found</h4>
                @if (User.IsInRole("Admin"))
                {
                    <p class="text-muted">Start by assigning a task to an employee.</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Assign First Task
                    </a>
                }
                else
                {
                    <p class="text-muted">You don't have any tasks assigned yet.</p>
                }
            </div>
        </div>
    }
</div>