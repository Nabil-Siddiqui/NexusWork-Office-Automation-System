@model NexusWork.Models.WorkTask

@{
    ViewData["Title"] = "Delete Task";
}

<div class="container">
    <h1 class="mb-4 text-danger">
        <i class="bi bi-trash"></i> Delete Task
    </h1>

    <div class="row">
        <div class="col-md-6">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <i class="bi bi-exclamation-triangle"></i> Confirm Deletion
                </div>
                <div class="card-body">
                    <p class="lead">Are you sure you want to delete this task?</p>

                    <dl class="row">
                        <dt class="col-sm-4">Title</dt>
                        <dd class="col-sm-8"><strong>@Model.Title</strong></dd>

                        <dt class="col-sm-4">Assigned To</dt>
                        <dd class="col-sm-8">@(Model.Employee?.FullName ?? "N/A")</dd>

                        <dt class="col-sm-4">Deadline</dt>
                        <dd class="col-sm-8">@Model.Deadline.ToString("dd MMM yyyy")</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">
                            <span class="badge @Model.StatusBadgeClass">@Model.Status</span>
                        </dd>
                    </dl>

                    <div class="alert alert-warning">
                        <i class="bi bi-exclamation-circle"></i> This action cannot be undone.
                    </div>
                </div>
                <div class="card-footer">
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Yes, Delete
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>