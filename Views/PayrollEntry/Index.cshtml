@model IEnumerable<NexusWork.Models.PayrollEntry>

@{
    ViewData["Title"] = "Payroll Management";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="bi bi-cash-stack"></i> Payroll Management
        </h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Generate Payroll
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Employee</th>
                                <th>Pay Period</th>
                                <th>Basic Salary</th>
                                <th>Gross Salary</th>
                                <th>Deductions</th>
                                <th>Net Salary</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><strong>@(item.Employee?.FullName ?? "N/A")</strong></td>
                                    <td>@item.PayPeriod</td>
                                    <td>৳ @item.BasicSalaryBDT.ToString("N2")</td>
                                    <td class="text-success">৳ @item.GrossSalaryBDT.ToString("N2")</td>
                                    <td class="text-danger">৳ @item.DeductionsBDT.ToString("N2")</td>
                                    <td class="fw-bold text-primary">৳ @item.NetSalaryBDT.ToString("N2")</td>
                                    <td>
                                        @if (item.IsPaid)
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">Pending</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info" title="View">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-cash fs-1 text-muted"></i>
                <h4 class="mt-3">No Payroll Records</h4>
                <p class="text-muted">Start by generating payroll for employees.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Generate First Payroll
                </a>
            </div>
        </div>
    }
</div>