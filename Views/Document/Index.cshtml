@model IEnumerable<NexusWork.Models.Document>

@{
    ViewData["Title"] = "Document Repository";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="bi bi-folder2-open"></i> Document Repository
        </h1>
        <span class="badge bg-info fs-6">
            <i class="bi bi-info-circle"></i> Demo Mode
        </span>
    </div>

    <!-- Info Alert -->
    <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
        <i class="bi bi-info-circle-fill me-2 fs-4"></i>
        <div>
            <strong>Note:</strong> This is a demonstration of the Document Repository feature.
            In production, this module will be integrated with cloud storage (Azure Blob Storage / AWS S3)
            for secure document management.
        </div>
    </div>

    <!-- Message Display -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-@TempData["MessageType"] alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Message"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Document Categories -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card bg-danger text-white h-100">
                <div class="card-body text-center">
                    <i class="bi bi-shield-check fs-1"></i>
                    <h5 class="mt-2">Policies</h5>
                    <p class="mb-0">@Model.Count(d => d.Category == "Policy") Documents</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-primary text-white h-100">
                <div class="card-body text-center">
                    <i class="bi bi-book fs-1"></i>
                    <h5 class="mt-2">Handbooks</h5>
                    <p class="mb-0">@Model.Count(d => d.Category == "Handbook") Documents</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-success text-white h-100">
                <div class="card-body text-center">
                    <i class="bi bi-file-earmark-text fs-1"></i>
                    <h5 class="mt-2">Templates</h5>
                    <p class="mb-0">@Model.Count(d => d.Category == "Template") Documents</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card bg-info text-white h-100">
                <div class="card-body text-center">
                    <i class="bi bi-ui-checks fs-1"></i>
                    <h5 class="mt-2">Forms</h5>
                    <p class="mb-0">@Model.Count(d => d.Category == "Form") Documents</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Documents Table -->
    <div class="card">
        <div class="card-header bg-dark text-white">
            <i class="bi bi-file-earmark-text"></i> Available Documents
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-secondary">
                        <tr>
                            <th style="width: 40px;"></th>
                            <th>Document Name</th>
                            <th>Description</th>
                            <th>Category</th>
                            <th>Type</th>
                            <th>Upload Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @if (item.FileType == "PDF")
                                    {
                                        <i class="bi bi-file-earmark-pdf text-danger fs-4"></i>
                                    }
                                    else if (item.FileType == "DOCX" || item.FileType == "DOC")
                                    {
                                        <i class="bi bi-file-earmark-word text-primary fs-4"></i>
                                    }
                                    else if (item.FileType == "XLSX" || item.FileType == "XLS")
                                    {
                                        <i class="bi bi-file-earmark-excel text-success fs-4"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-file-earmark fs-4"></i>
                                    }
                                </td>
                                <td><strong>@item.DocumentName</strong></td>
                                <td><small class="text-muted">@item.Description</small></td>
                                <td>
                                    <span class="badge @item.CategoryBadgeClass">@item.Category</span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@item.FileType</span>
                                </td>
                                <td>@item.UploadDate.ToString("dd MMM yyyy")</td>
                                <td>
                                    @if (item.IsAvailable)
                                    {
                                        <span class="badge bg-success">Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning">Demo</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Download" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-download"></i> Download
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Future Scope Card -->
    <div class="card mt-4">
        <div class="card-header bg-secondary text-white">
            <i class="bi bi-lightbulb"></i> Future Enhancements
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-4">
                    <h6><i class="bi bi-cloud-upload text-primary"></i> Cloud Storage</h6>
                    <p class="text-muted small">Integration with Azure Blob Storage or AWS S3 for secure file storage.</p>
                </div>
                <div class="col-md-4">
                    <h6><i class="bi bi-lock text-success"></i> Access Control</h6>
                    <p class="text-muted small">Role-based document access - restrict sensitive documents to specific departments.</p>
                </div>
                <div class="col-md-4">
                    <h6><i class="bi bi-clock-history text-warning"></i> Version History</h6>
                    <p class="text-muted small">Track document changes and maintain version history for compliance.</p>
                </div>
            </div>
        </div>
    </div>
</div>