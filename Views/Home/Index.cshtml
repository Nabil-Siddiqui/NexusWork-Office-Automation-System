@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="bg-primary text-white py-5 mb-5" style="margin: -1rem -1rem 0 -1rem; padding-left: 2rem; padding-right: 2rem;">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-7">
                <h1 class="display-4 fw-bold">
                    <i class="bi bi-building"></i> NexusWork
                </h1>
                <p class="lead mb-4">
                    Complete Office Automation System for Modern Workplaces
                </p>
                <p class="mb-4">
                    Streamline your HR operations, manage employees, track tasks, and process payroll - all in one integrated platform.
                </p>
                @if (User.Identity.IsAuthenticated)
                {
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-light btn-lg me-2">
                            <i class="bi bi-speedometer2"></i> Go to Dashboard
                        </a>
                    }
                    else
                    {
                        <a asp-controller="EmployeeDashboard" asp-action="Index" class="btn btn-light btn-lg me-2">
                            <i class="bi bi-speedometer2"></i> My Dashboard
                        </a>
                    }
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-light btn-lg me-2">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-person-plus"></i> Register
                    </a>
                }
            </div>
            <div class="col-md-5 text-center d-none d-md-block">
                <i class="bi bi-diagram-3 display-1" style="font-size: 12rem; opacity: 0.3;"></i>
            </div>
        </div>
    </div>
</div>

<!-- Features Section -->
<div class="container mb-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold">Key Features</h2>
        <p class="text-muted">Everything you need to manage your office efficiently</p>
    </div>

    <div class="row g-4">
        <!-- Feature 1 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-people-fill text-primary fs-1"></i>
                    </div>
                    <h5 class="card-title">Employee Management</h5>
                    <p class="card-text text-muted">
                        Maintain comprehensive digital profiles for all employees with personal details, employment history, and bank information.
                    </p>
                </div>
            </div>
        </div>

        <!-- Feature 2 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-list-task text-success fs-1"></i>
                    </div>
                    <h5 class="card-title">Task Management</h5>
                    <p class="card-text text-muted">
                        Assign tasks to employees, set priorities and deadlines, and track progress in real-time for better productivity.
                    </p>
                </div>
            </div>
        </div>

        <!-- Feature 3 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-cash-stack text-warning fs-1"></i>
                    </div>
                    <h5 class="card-title">Payroll Processing</h5>
                    <p class="card-text text-muted">
                        Generate monthly payroll with allowances and deductions. Employees can view their payslips anytime.
                    </p>
                </div>
            </div>
        </div>

        <!-- Feature 4 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-info bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-file-earmark-text text-info fs-1"></i>
                    </div>
                    <h5 class="card-title">Document Repository</h5>
                    <p class="card-text text-muted">
                        Centralized storage for company policies, handbooks, forms, and templates accessible to all employees.
                    </p>
                </div>
            </div>
        </div>

        <!-- Feature 5 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-danger bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-shield-lock text-danger fs-1"></i>
                    </div>
                    <h5 class="card-title">Role-Based Access</h5>
                    <p class="card-text text-muted">
                        Secure access control with Admin and Employee roles. Each user sees only what they're authorized to access.
                    </p>
                </div>
            </div>
        </div>

        <!-- Feature 6 -->
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body text-center p-4">
                    <div class="bg-secondary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-graph-up-arrow text-secondary fs-1"></i>
                    </div>
                    <h5 class="card-title">Dashboard Analytics</h5>
                    <p class="card-text text-muted">
                        Visual dashboards for admins and employees showing key metrics, task status, and important notifications.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- User Roles Section -->
<div class="bg-light py-5 mb-5" style="margin-left: -1rem; margin-right: -1rem; padding-left: 2rem; padding-right: 2rem;">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="fw-bold">User Roles</h2>
            <p class="text-muted">Different access levels for different responsibilities</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-5 mb-4">
                <div class="card border-primary h-100">
                    <div class="card-header bg-primary text-white text-center py-3">
                        <i class="bi bi-person-gear fs-1"></i>
                        <h4 class="mb-0 mt-2">Administrator</h4>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Manage all employees</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Assign tasks to any employee</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Generate & manage payroll</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> View all reports & analytics</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Manage document repository</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Full system access</li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="col-md-5 mb-4">
                <div class="card border-success h-100">
                    <div class="card-header bg-success text-white text-center py-3">
                        <i class="bi bi-person-badge fs-1"></i>
                        <h4 class="mb-0 mt-2">Employee</h4>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> View personal dashboard</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> See assigned tasks only</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> View own payslips</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Access personal profile</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Download company documents</li>
                            <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Limited system access</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tech Stack Section -->
<div class="container mb-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold">Technology Stack</h2>
        <p class="text-muted">Built with modern, reliable technologies</p>
    </div>

    <div class="row text-center">
        <div class="col-md-3 col-6 mb-4">
            <div class="p-3">
                <i class="bi bi-filetype-cs text-primary" style="font-size: 3rem;"></i>
                <h6 class="mt-2">C# .NET 8</h6>
                <small class="text-muted">Backend</small>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-4">
            <div class="p-3">
                <i class="bi bi-layers text-success" style="font-size: 3rem;"></i>
                <h6 class="mt-2">ASP.NET MVC</h6>
                <small class="text-muted">Framework</small>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-4">
            <div class="p-3">
                <i class="bi bi-database text-info" style="font-size: 3rem;"></i>
                <h6 class="mt-2">SQL Server</h6>
                <small class="text-muted">Database</small>
            </div>
        </div>
        <div class="col-md-3 col-6 mb-4">
            <div class="p-3">
                <i class="bi bi-bootstrap text-purple" style="font-size: 3rem; color: #7952b3;"></i>
                <h6 class="mt-2">Bootstrap 5</h6>
                <small class="text-muted">UI Framework</small>
            </div>
        </div>
    </div>
</div>

<!-- Footer -->
<div class="bg-dark text-white py-4" style="margin: 0 -1rem -1rem -1rem; padding-left: 2rem; padding-right: 2rem;">
    <div class="container">
        <div class="row">
            <div class="col-md-6">
                <h5><i class="bi bi-building"></i> NexusWork</h5>
                <p class="text-muted mb-0">Office Automation System</p>
                <p class="text-muted small">University Project - 2025</p>
            </div>
            <div class="col-md-6 text-md-end">
                <p class="text-muted mb-1">Built with</p>
                <span class="badge bg-primary me-1">ASP.NET Core</span>
                <span class="badge bg-success me-1">Entity Framework</span>
                <span class="badge bg-info">Bootstrap</span>
            </div>
        </div>
    </div>
</div>